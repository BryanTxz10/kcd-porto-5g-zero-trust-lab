# Patch estratégico del Deployment del UPF (Fase 1, deploy_multus: true).
# Añade un initContainer que, ya con n6 creada por Multus, hace policy routing:
# lo que sale del pool de UE ({{ ue_pool_cidr }}) va por n6 a dn-gw
# ({{ dn_gw_n6_ip }}); el resto del pod (N4, DNS) sigue por eth0 (Cilium).
# Privilegiado porque escribe sysctl de red (rp_filter, ip_forward) en el
# netns del pod; 5g-up ya es enforce=privileged (hardening.yml). Es un
# initContainer: termina antes de que arranque el UPF.
spec:
  template:
    spec:
      initContainers:
        - name: n6-route
          image: {{ netshoot_image }}
          command: ["/bin/sh", "-ec"]
          args:
            - |
              sysctl -w net.ipv4.ip_forward=1
              sysctl -w net.ipv4.conf.all.rp_filter=0
              sysctl -w net.ipv4.conf.{{ multus_n6_iface }}.rp_filter=0
              ip rule show | grep -q 'from {{ ue_pool_cidr }} lookup {{ upf_n6_route_table }}' \
                || ip rule add from {{ ue_pool_cidr }} lookup {{ upf_n6_route_table }} priority 1000
              ip route replace default via {{ dn_gw_n6_ip }} dev {{ multus_n6_iface }} table {{ upf_n6_route_table }}
              ip rule show; ip route show table {{ upf_n6_route_table }}
          securityContext:
            privileged: true

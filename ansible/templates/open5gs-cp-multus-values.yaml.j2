# open5gs-cp-multus-values.yaml — generado por Ansible (deploy_multus: true).
# Se pasa como -f extra al release {{ open5gs_release }}, encima de
# helm-values/open5gs-values.yaml.
#
# AMF: interfaz n2 = {{ amf_n2_ip }} en la red access (anotación de Multus).
# La config del AMF con NGAP en esa IP está en open5gs-cp-nf-config-values.yaml
# (templates/open5gs-cp-nf-config-values.yaml.j2), que se genera si
# deploy_multus o sbi_tls están activos.
#
# ⚠ NO VERIFICADO contra el chart 2.3.4: 'amf.podAnnotations'.
amf:
  podAnnotations:
    k8s.v1.cni.cncf.io/networks: '[{"name": "access", "interface": "n2", "ips": ["{{ amf_n2_ip }}/{{ access_cidr.split('/')[1] }}"]}]'

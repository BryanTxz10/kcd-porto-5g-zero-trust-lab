# Patch estratégico del Deployment ueransim-gnb (Fase 1, deploy_multus: true).
# El gNB recibe la interfaz 'access' (NAD gnb-access, {{ gnb_access_ip }}) y la
# usa para N2 y N3; la radio simulada (RLS con el UE) sigue por la red de pods.
# Llega al AMF directamente por {{ amf_n2_ip }}, sin el Service headless.
# Las variables N2_IP/N3_IP/AMF_N2_ADDR no existen en el manifiesto base a
# propósito: así 'kubectl apply' del base no deshace este patch.
spec:
  template:
    metadata:
      annotations:
        k8s.v1.cni.cncf.io/networks: '[{"name": "gnb-access", "interface": "access"}]'
    spec:
      containers:
        - name: gnb
          env:
            - { name: N2_IP, value: "{{ gnb_access_ip }}" }
            - { name: N3_IP, value: "{{ gnb_access_ip }}" }
            - { name: AMF_N2_ADDR, value: "{{ amf_n2_ip }}" }

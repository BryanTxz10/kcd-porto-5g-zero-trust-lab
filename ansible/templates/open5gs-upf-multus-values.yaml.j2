# open5gs-upf-multus-values.yaml — generado por Ansible (Fase 1, deploy_multus: true).
# Se pasa como SEGUNDO -f al release {{ open5gs_up_release }}, encima de
# helm-values/open5gs-upf-values.yaml.
#
# UPF: interfaz n3 (NAD upf-n3, {{ upf_n3_ip }}) para GTP-U y n6 (NAD upf-n6,
# {{ upf_n6_ip }}) hacia dn-gw. N4 (PFCP) sigue por la red de pods.
# Sin NAT en el UPF: lo hace dn-gw, que enruta {{ ue_pool_cidr }} de vuelta
# por {{ upf_n6_ip }}. La ruta de salida del pool por n6 la pone un
# initContainer que añade Ansible después del helm (templates/upf-n6-route-patch.yaml.j2).
#
# ⚠ NO VERIFICADO contra el chart: se asume que el subchart del UPF de Gradiant
#   acepta 'podAnnotations' y 'customOpen5gsConfig' fusionado sobre el upf.yaml
#   que genera. Comprueba con helm template (docs/fase1-multus.md §4).
upf:
  podAnnotations:
    k8s.v1.cni.cncf.io/networks: '[{"name": "upf-n3", "interface": "n3"}, {"name": "upf-n6", "interface": "n6"}]'
  config:
    # Misma lista que en open5gs-upf-values.yaml, pero sin NAT (las listas
    # de Helm se sustituyen, no se fusionan: hay que repetirla entera).
    subnetList:
      - subnet: {{ ue_pool_cidr }}
        gateway: {{ ue_pool_cidr | regex_replace('\.0/\d+$', '.1') }}
        dnn: internet
        dev: ogstun
        mask: {{ ue_pool_cidr.split('/')[1] }}
        createDev: true
        enableNAT: false
  customOpen5gsConfig:
    upf:
      gtpu:
        server:
          - address: {{ upf_n3_ip }}

# .gitignore

# Logs de las demos y de la prueba de humo (smoke_*.txt) y capturas de Hubble
*.txt
!requirements.txt
*.jsonl
!tools/spec2policy/fixtures/**/*.jsonl
capturas/

# Salidas locales
*.csv
*.png

# Python
__pycache__/
*.pyc
.venv/
venv/

# Kubernetes / kubeconfig local
kubeconfig
*.kubeconfig

# Archivos temporales del sistema
.DS_Store
*.swp

# El blast radius map de ejemplo y la plantilla sí van al repo
!tools/spec2policy/**/*.csv
!docs/**/*.csv
